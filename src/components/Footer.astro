---
import Social from "./Social.astro";
import PhoenixBrandmark from "./PhoenixBrandmark.astro";
---

<footer>
  <div class="sm:flex-col">
    <PhoenixBrandmark class="h-8" />
    <a
      href="https://PhoenixTheatrical.com/"
      class="flex items-center mb-4 sm:mb-0 space-x-3 rtl:space-x-reverse"
    >
      <span
        class="self-center text-2xl font-semibold whitespace-nowrap dark:text-white"
        >Flowbite</span
      >
    </a>

    <div class="sm:flex sm:items-center sm:justify-between">
      <span class="text-sm text-gray-500 sm:text-center dark:text-gray-400"
        >© 2025 <a
          href="https://PhoenixTheatrical.com/"
          class="hover:underline">PhoenixTheatrical</a
        >. All Rights Reserved.
      </span>
      
      <Social
        platform="LinkedIn"
        link="https://www.linkedin.com/in/bryce-bienz/"
      />
      <Social 
        platform="Github" 
        link="https://github.com/PhoenixTheatrical" />
    </div>
  </div>
</footer>
